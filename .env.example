# Copy to .env and adjust. Nothing here is secret except ANTHROPIC_API_KEY.

# Postgres (Docker Compose exposes it on 5433 to avoid clashing with other local instances)
POSTGRES_USER=rmw
POSTGRES_PASSWORD=rmw_local_dev
POSTGRES_DB=rm_workbench
POSTGRES_PORT=5433
DATABASE_URL=postgres://rmw:rmw_local_dev@localhost:5433/rm_workbench

# API
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Analytics service (FastAPI)
ANALYTICS_URL=http://localhost:8000

# Dataset: any directory with the files described in docs/DATASET_CONTRACT.md
# DATA_DIR=/absolute/path/to/data
# DATASET_TODAY=YYYY-MM-DD   (optional; defaults to the latest snapshot in the data)
DATASET_NAME=SingHacks 2026 Julius Baer wealth intelligence

# Claude. Leave empty to run the gateway in recorded/replay mode.
ANTHROPIC_API_KEY=
CLAUDE_ANALYSIS_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5
# Set to true (with a key) to save each schema-valid Claude response under apps/api/recordings
CLAUDE_RECORD=false

# Workflow: the signed-in RM approval level and the id recorded for second-RM (checker) approvals
CHECKER_ID=RM-CHECKER

# --- identity and isolation (iteration D1/D2) ---
# The API connects as the non-superuser application role so row-level security applies.
API_DATABASE_URL=postgres://rmw_app:rmw_app_dev@127.0.0.1:5433/rm_workbench
# dev: the API lists identities and issues tokens itself. oidc: verify tokens from the bank's provider.
AUTH_MODE=dev
AUTH_SECRET=dev-only-secret-change-me-please
AUTH_TOKEN_TTL_SECONDS=28800
# AUTH_ISSUER=https://login.example.bank/realms/rm
# AUTH_AUDIENCE=rm-workbench
# AUTH_JWKS_URL=https://login.example.bank/realms/rm/protocol/openid-connect/certs

# --- Kafka front door (apps/ingest); local Redpanda via `npm run kafka:up` ---
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=rmw.ingest
KAFKA_GROUP_ID=rmw-ingest
# INGEST_DATABASE_URL=postgres://rmw_ingest:...@127.0.0.1:5433/rm_workbench

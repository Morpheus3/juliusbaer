    {
      "eventId": "EV-010",
      "match": [{ "sector": "Energy" }, { "exposureName": "Pacific Orient Shipping" }],
      "shock": { "brent_pct": 6, "sector_overlay_pct": { "Energy": 4 } },
      "note": "Brent peaks near USD 114."
    },
    {
      "eventId": "EV-011",
      "match": [
        { "sector": "Information Technology" },

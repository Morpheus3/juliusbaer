{
  "$comment": "How each event in event_log.csv reaches portfolios. `match` rules select instruments by attribute (sector, subAssetClass, assetClass, region, currency, exposureName, liquidityTier, hasFacility). `shock` is the base-case factor move the event implies; scenario severities scale it. Every rule is a stated judgement and is shown in the evidence drawer.",
  "events": [
    {
      "eventId": "EV-001",
      "match": [{ "sector": "Gold" }],
      "shock": { "gold_pct": 8 },
      "note": "Gold's 2025 rally; positions already marked, shock represents continuation."
    },
    {
      "eventId": "EV-002",
      "match": [{ "sector": "Gold" }],
      "shock": { "gold_pct": 5 },
      "note": "Spot gold through USD 5,000."
    },
    {
      "eventId": "EV-003",
      "match": [{ "sector": "Gold" }],
      "shock": { "gold_pct": -6 },
      "note": "Intraday high then consolidation: downside for gold-heavy books."
    },
    {
      "eventId": "EV-004",
      "match": [
        { "sector": "Energy" },
        { "subAssetClass": "Emerging Market Debt" },
        { "sector": "Gold" },
        { "region": "Middle East" },
        { "exposureName": "Global Defence and Aerospace Equity Fund" }
      ],
      "shock": {
        "brent_pct": 12,
        "equity_pct": { "global": -4 },
        "sector_overlay_pct": { "Energy": 10, "Industrials": 2 },
        "gold_pct": 4,
        "vix_points": 8,
        "credit_spread_bps": { "em": 40 }
      },
      "note": "Start of hostilities: energy up, risk assets down, safe havens bid, EM credit wider."
    },
    {
      "eventId": "EV-005",
      "match": [
        { "sector": "Energy" },
        { "exposureName": "Pacific Orient Shipping" },
        { "exposureName": "Gulf Marine Services" },
        { "subAssetClass": "Diversified Commodities" }
      ],
      "shock": { "brent_pct": 12, "sector_overlay_pct": { "Energy": 8, "Industrials": 5 } },
      "note": "Tanker traffic stalls; shipping and energy re-rate."
    },
    {
      "eventId": "EV-006",
      "match": [
        { "sector": "Energy" },
        { "exposureName": "Pacific Orient Shipping" },
        { "exposureName": "Gulf Marine Services" },
        { "region": "Middle East" },
        { "subAssetClass": "Diversified Commodities" }
      ],
      "shock": {
        "brent_pct": 40,
        "equity_pct": { "global": -6, "asia_ex_japan": -5 },
        "sector_overlay_pct": { "Energy": 18, "Industrials": 8 },
        "gold_pct": 3,
        "vix_points": 12,
        "fx_pct_vs_usd": { "SGD": -1.5, "IDR": -3, "INR": -1.5, "THB": -3 }
      },
      "note": "Strait of Hormuz closed: the defining shock of 2026 for this book."
    },
    {
      "eventId": "EV-007",
      "match": [{ "sector": "Energy" }, { "subAssetClass": "Yield Enhancement" }],
      "shock": { "brent_pct": -8, "sector_overlay_pct": { "Energy": -4 } },
      "note": "Emergency reserve release: partial relief for energy-linked notes."
    },
    {
      "eventId": "EV-008",
      "match": [
        { "sector": "Energy" },
        { "subAssetClass": "Inflation Linked" },
        { "subAssetClass": "Government Bond" }
      ],
      "shock": { "brent_pct": 5, "rates_bps": { "USD": 15, "EUR": 10 } },
      "note": "Largest supply disruption on record: inflation-sensitive assets reprice."
    },
    {
      "eventId": "EV-009",
      "match": [{ "currency": "EUR", "assetClass": "Fixed Income" }, { "currency": "EUR" }],
      "shock": { "rates_bps": { "EUR": 25 }, "fx_pct_vs_usd": { "EUR": 1 } },
      "note": "ECB hikes into an energy-driven inflation impulse."

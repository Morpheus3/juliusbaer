      "UST_10Y_PCT": 0.15,
      "BRENT_USD_BBL": 10,
      "GOLD_USD_OZ": 6,
      "VIX": 6,
      "SPX": 4,
      "NASDAQ_COMP": 5,
      "HSI": 4,
      "STI": 3,
      "MSCI_ASIA_XJP": 4,
      "USDSGD": 1.5,
      "EURUSD": 2,
      "USDJPY": 2.5,
      "USDHKD": 0.3,
      "USDIDR": 3,
      "USDINR": 2,
      "USDTHB": 3,
      "TTF_GAS_EUR_MWH": 25,
